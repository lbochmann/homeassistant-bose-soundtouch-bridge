# Standalone image for running the bridge outside Home Assistant Supervisor
# (e.g. Home Assistant Container, plain Docker, Portainer, a NAS, a Pi).
# Inside HAOS / Supervised, use the Supervisor add-on (see `Dockerfile`).

FROM python:3.12-alpine

RUN apk add --no-cache libxml2 libxslt ca-certificates \
 && apk add --no-cache --virtual .build-deps gcc musl-dev libxml2-dev libxslt-dev \
 && pip install --no-cache-dir \
        upnpclient \
        websocket-client \
        paho-mqtt \
 && apk del .build-deps

COPY bridge.py /bridge.py

# Speaker config: JSON array of speaker entries. Each entry has optional `host`
# and `name` plus `preset_1_url` .. `preset_6_url`. An entry with neither host
# nor name is a wildcard — its preset map is applied to every discovered
# speaker no explicit entry claimed.
#
# Examples:
#   SPEAKERS_JSON='[{"preset_1_url":"http://..."}]'                # one preset map for all speakers
#   SPEAKERS_JSON='[{"name":"Wohnzimmer","preset_1_url":"..."}]'   # only Wohnzimmer
#   SPEAKERS_JSON='[{"name":"Bad","preset_1_url":"..."},
#                   {"preset_1_url":"..."}]'                       # Bad-specific + wildcard fallback
# Shortcut for the common "same presets on every speaker" case — set these
# instead of (or alongside) SPEAKERS_JSON. They're appended as a wildcard
# entry unless SPEAKERS_JSON already contains one.
ENV PRESET_1_URL=""
ENV PRESET_2_URL=""
ENV PRESET_3_URL=""
ENV PRESET_4_URL=""
ENV PRESET_5_URL=""
ENV PRESET_6_URL=""

ENV SPEAKERS_JSON=""
ENV SYNC_PRESETS_ON_STARTUP="true"
# HTTPS stream proxy is always on (SoundTouch firmware only speaks plain
# HTTP) — only the port is configurable, in case 9000 collides with
# something else on the host.
ENV PROXY_PORT="9000"

# MQTT (optional — leave MQTT_HOST blank to disable HA control buttons)
ENV MQTT_HOST=""
ENV MQTT_PORT="1883"
ENV MQTT_USERNAME=""
ENV MQTT_PASSWORD=""

CMD ["python3", "-u", "/bridge.py"]
